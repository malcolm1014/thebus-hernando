# Node
node_modules/
npm-debug.log*

# Backend runtime artifacts (regenerated by ETL, never hand-edited or committed)
backend/data/raw/
backend/data/transit_data.json
backend/data/*.zip
backend/data/push-registry.json
backend/.env

# Frontend / Capacitor
frontend/android/
frontend/ios/
frontend/plugins/*/android/build/
frontend/plugins/*/android/.gradle/
frontend/www/data/transit_data.json
frontend/.env

# Signing keys & service credentials -- never commit a real one.
# The debug keystore below is deliberately tracked (shared, well-known
# "android" password, debug builds only), so it is excepted.
*.keystore
*.jks
!frontend/keystore/debug.keystore
google-services.json
**/*service-account*.json

# Misc
.DS_Store
*.log
